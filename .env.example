# Demo mode — mock/install.ts patches window.fetch and intercepts every
# request when this is "1" (the default even if this var is unset). There is
# no real backend behind this deployment; set to "0" only if you've pointed
# this build at an actual SendDesk API and want to turn the mock off.
NEXT_PUBLIC_DEMO=1

# Placeholders only. lib/api/*.ts reference these, but the mock intercepts
# every request before any of it reaches a real network call, so the values
# below are never actually dialed. Do not point these at a real host.
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid
NEXT_PUBLIC_API_VERSION=v2
